# Streamlit Cloud: App settings -> Secrets -> paste this content with your real keys.
# Local computer: save it as ".streamlit/secrets.toml".
# Never upload the file that contains real keys to GitHub.
GROQ_API_KEY = "your_groq_key_here"
GEMINI_API_KEY = "your_gemini_key_here"

# Optional
# DAILY_LIMIT = 800                   # total AI requests per day (all users)
# GROQ_MODEL = "openai/gpt-oss-120b"   # use when a model is retired
# GROQ_VISION_MODEL = "qwen/qwen3.8-27b"
# GEMINI_MODEL = "gemini-flash-latest"
# DEBUG = "1"                          # show technical error details (admin only)
